# PetCare Spa - biến môi trường. Sao chép file này thành ".env" rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

# --- Bảo mật ---
SECRET_KEY=doi-thanh-chuoi-bi-mat-rieng-cua-ban

# --- AI (Google Gemini) ---
# Lấy API key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model có thể đổi tuỳ ý (xem danh sách tại https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=30

# --- Giới hạn & vận hành ---
AI_RATE_LIMIT_PER_MIN=20        # số lượt gọi AI tối đa mỗi người dùng mỗi phút
LOGIN_MAX_FAILURES=5            # đăng nhập sai tối đa trước khi bị khóa 15 phút
CORS_ORIGINS=                   # để trống nếu giao diện cùng origin; hoặc: http://a.com,http://b.com
# DATABASE_PATH=/data/petcare.db   # đổi vị trí CSDL (Docker đã đặt sẵn)
# BACKUP_DIR=/data/backups
